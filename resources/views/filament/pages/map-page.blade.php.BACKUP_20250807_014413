    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script>
        console.log('Leaflet loaded:', typeof L);
        
        // SIMPLIFIED and RELIABLE map initialization
        function initializeMap() {
            console.log('SIMPLIFIED map initialization starting...');
            
            try {
                // Verify map element exists
                const mapElement = document.getElementById('map');
                if (!mapElement) {
                    console.error('Map element not found!');
                    return false;
                }
                
                console.log('Map element found, initializing...');
                
                // Force proper dimensions BEFORE initializing Leaflet
                mapElement.style.width = '100%';
                mapElement.style.height = '100%';
                mapElement.style.minHeight = '400px';
                mapElement.style.background = '#f0f0f0';
                
                const container = mapElement.parentElement;
                if (container) {
                    container.style.width = '100%';
                    container.style.height = '100%';
                    container.style.background = '#f0f0f0';
                }
                
                // Create map with simpler configuration
                const map = L.map('map', {
                    center: [0, 0],
                    zoom: 2,
                    zoomControl: true,
                    attributionControl: true
                });
                
                // Store globally
                window.mapInstance = map;
                
                // CRÍTICO: Add tiles with MULTIPLE fallbacks to prevent white screen
                let tileLayer;
                
                // Try OpenStreetMap first
                tileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors',
                    maxZoom: 19,
                    crossOrigin: true
                });
                
                // CRITICAL: Handle tile loading errors with fallback
                let tileErrorCount = 0;
                tileLayer.on('tileerror', function(e) {
                    tileErrorCount++;
                    console.error('CRITICAL: Tile loading error #' + tileErrorCount, e);
                    
                    if (tileErrorCount > 5) {
                        console.error('CRITICAL: Too many tile errors, switching to fallback tiles');
                        
                        // Remove failed layer
                        map.removeLayer(tileLayer);
                        
                        // Add fallback tile source
                        const fallbackTileLayer = L.tileLayer('https://cartodb-basemaps-{s}.global.ssl.fastly.net/light_all/{z}/{x}/{y}.png', {
                            attribution: '© OpenStreetMap contributors, © CartoDB',
                            maxZoom: 19,
                            subdomains: 'abcd'
                        }).addTo(map);
                        
                        console.log('FALLBACK tiles loaded');
                    }
                });
                
                tileLayer.on('tileload', function() {
                    console.log('TILES LOADING SUCCESSFULLY');
                });
                
                // Add primary tile layer
                tileLayer.addTo(map);
                
                console.log('Basic map created with tiles');
                
                // Create markers layer
                window.markersLayer = L.layerGroup().addTo(map);
                
                // Load initial markers
                loadMapMarkers(map);
                
                // Single resize after everything is loaded
                setTimeout(function() {
                    map.invalidateSize();
                    console.log('Map resized and ready');
                }, 200);
                
                return true;
                
            } catch (error) {
                console.error('Error initializing map:', error);
                return false;
            }
        }
        
        // SEPARATE function to load markers
        function loadMapMarkers(map) {
            try {
                // Get data
                const devices = @json($devices);
                const positions = @json($positions);
                
                console.log('Loading', devices.length, 'devices and', positions.length, 'positions');
                
                if (devices.length === 0) {
                    console.warn('No devices found to display on map');
                    return;
                }
                
                // Create device lookup
                const deviceMap = {};
                devices.forEach(device => {
                    deviceMap[device.id] = device;
                });
                
                // Add markers and track bounds
                const bounds = [];
                let markersAdded = 0;
                
                positions.forEach(position => {
                    const device = deviceMap[position.deviceId];
                    if (device && position.latitude && position.longitude && 
                        !isNaN(position.latitude) && !isNaN(position.longitude)) {
                        
                        const marker = L.marker([position.latitude, position.longitude])
                            .bindPopup(`<b>${device.name}</b><br>ID: ${device.uniqueId}<br>Last Update: ${new Date(position.fixTime || position.deviceTime).toLocaleString()}`);
                        
                        window.markersLayer.addLayer(marker);
                        bounds.push([position.latitude, position.longitude]);
                        markersAdded++;
                    }
                });
                
                console.log('Added', markersAdded, 'valid markers to map');
                
                // CRITICAL: Decidir cómo ajustar la vista del mapa
                if (isDeviceSelected && selectedDeviceId) {
                    // Si hay dispositivo seleccionado, mantener vista en él
                    const selectedPosition = positions.find(p => p.deviceId === selectedDeviceId);
                    if (selectedPosition && selectedPosition.latitude && selectedPosition.longitude) {
                        map.setView([selectedPosition.latitude, selectedPosition.longitude], selectedDeviceZoom || 16, {
                            animate: false // Sin animación para que sea instantáneo
                        });
                        console.log(`🎯 MAINTAINED VIEW on selected device ID: ${selectedDeviceId}`);
                    } else {
                        console.warn(`⚠️ Selected device ${selectedDeviceId} position not found, falling back to general view`);
                        if (bounds.length > 0) {
                            map.fitBounds(bounds, { padding: [20, 20] });
                        }
                    }
                } else {
                    // Vista general normal si no hay dispositivo seleccionado
                    if (bounds.length > 0) {
                        map.fitBounds(bounds, { padding: [20, 20] });
                        console.log('🗺️ General view - fitted to all', bounds.length, 'positions');
                    } else {
                        console.warn('No valid positions found for map bounds');
                    }
                }
                
            } catch (error) {
                console.error('Error loading markers:', error);
            }
        }
        
        // CRITICAL: Initialize map with multiple safety checks
        document.addEventListener('DOMContentLoaded', function () {
            console.log('DOM ready, starting CRITICAL map initialization...');
            
            // Force visibility immediately
            setTimeout(forceMapToStayVisible, 100);
            
            // Try to initialize with retries
            let initAttempts = 0;
            
            function attemptMapInit() {
                initAttempts++;
                console.log('Map initialization attempt #' + initAttempts);
                
                const success = initializeMap();
                if (success) {
                    console.log('✅ MAP INITIALIZATION SUCCESSFUL!');
                    mapInitialized = true;
                    
                    // Force visibility again after successful init
                    setTimeout(forceMapToStayVisible, 500);
                    
                } else if (initAttempts < 5) {
                    console.warn('❌ Initialization attempt #' + initAttempts + ' failed, retrying...');
                    setTimeout(attemptMapInit, 2000);
                } else {
                    console.error('❌ CRITICAL: All map initialization attempts failed!');
                    emergencyMapRecovery();
                }
            }
            
            // Start first attempt
            setTimeout(attemptMapInit, 300);
            
            // Keep forcing visibility every 3 seconds as safety net
            setInterval(forceMapToStayVisible, 3000);
            
            // NUEVO: Configurar event listeners para modal compacto
            const closeButton = document.getElementById('closeCompactModal');
            if (closeButton) {
                closeButton.addEventListener('click', closeCompactModal);
            }
            
            // Cerrar modal al hacer clic fuera (opcional)
            const modal = document.getElementById('compactDeviceModal');
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        closeCompactModal();
                    }
                });
            }
            
            // Cerrar modal con tecla ESC
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeCompactModal();
                }
            });
        });
        
        // NUEVO: Actualizar modal del dispositivo seleccionado durante refresh
        function updateSelectedDeviceModal() {
            if (!isDeviceSelected || !selectedDeviceId) {
                return;
            }
            
            // Verificar que el modal esté abierto
            const modal = document.getElementById('compactDeviceModal');
            if (!modal || !modal.classList.contains('show')) {
                return;
            }
            
            try {
                // Obtener datos actualizados
                const devices = @json($devices);
                const positions = @json($positions);
                
                // Encontrar dispositivo y posición actualizados
                const device = devices.find(d => d.id === selectedDeviceId);
                const position = positions.find(p => p.deviceId === selectedDeviceId);
                
                if (device) {
                    // Actualizar contenido del modal sin cerrar/abrir
                    const modalContent = generateCompactModalContent(device, position);
                    const contentDiv = document.getElementById('compactModalContent');
                    
                    if (contentDiv) {
                        contentDiv.innerHTML = modalContent;
                        console.log(`🔄 Updated modal content for device: ${device.name}`);
                    }
                } else {
                    console.warn(`⚠️ Selected device ${selectedDeviceId} not found in refresh data`);
                }
                
            } catch (error) {
                console.error('Error updating selected device modal:', error);
            }
        }

        // NUEVO: Focus en dispositivo con persistencia durante refresh
        function focusOnDevice(deviceId) {
            console.log('🔥 CLICK DEBUG: focusOnDevice called with deviceId:', deviceId);
            
            const mapInstance = window.mapInstance;
            if (!mapInstance) {
                console.warn('❌ CLICK DEBUG: Map not initialized yet');
                return;
            }
            console.log('✅ CLICK DEBUG: Map instance found');

            // Get device and position data
            const devices = @json($devices);
            const positions = @json($positions);
            
            console.log('📊 CLICK DEBUG: Available devices:', devices.length, 'positions:', positions.length);

            // Find the device
            const device = devices.find(d => d.id === deviceId);
            if (!device) {
                console.error('❌ CLICK DEBUG: Device not found for ID:', deviceId);
                console.log('📋 CLICK DEBUG: Available device IDs:', devices.map(d => d.id));
                return;
            }
            console.log('✅ CLICK DEBUG: Device found:', device.name);

            // Find the device position
            const position = positions.find(p => p.deviceId === deviceId);
            if (!position || !position.latitude || !position.longitude) {
                console.error('❌ CLICK DEBUG: Position not found for device:', device.name);
                console.log('📋 CLICK DEBUG: Available position deviceIds:', positions.map(p => p.deviceId));
                return;
            }
            console.log('✅ CLICK DEBUG: Position found for device');

            // CRITICAL: Guardar dispositivo seleccionado para persistencia
            selectedDeviceId = deviceId;
            selectedDeviceZoom = 16; // Zoom preferido para dispositivo individual
            isDeviceSelected = true;
            
            console.log(`🎯 DEVICE SELECTED FOR PERSISTENCE: ${device.name} (ID: ${deviceId})`);

            // Center map on device location
            mapInstance.setView([position.latitude, position.longitude], selectedDeviceZoom, {
                animate: true,
                duration: 1.0
            });

            // Find and highlight the marker
            mapInstance.eachLayer(function(layer) {
                if (layer instanceof L.Marker) {
                    const markerLatLng = layer.getLatLng();
                    if (Math.abs(markerLatLng.lat - position.latitude) < 0.0001 && 
                        Math.abs(markerLatLng.lng - position.longitude) < 0.0001) {
                        // Open popup for this marker
                        layer.openPopup();
                        
                        // Add temporary highlight effect
                        const icon = layer.getElement();
                        if (icon) {
                            icon.style.filter = 'drop-shadow(0 0 10px #3b82f6)';
                            setTimeout(() => {
                                icon.style.filter = '';
                            }, 2000);
                        }
                    }
                }
            });

            // Update device card styling to show PERSISTENT selection
            document.querySelectorAll('.device-card').forEach(card => {
                card.classList.remove('bg-blue-100', 'dark:bg-blue-800', 'border-blue-300', 'dark:border-blue-600');
            });
            
            const selectedCard = document.querySelector(`[data-device-id="${deviceId}"]`);
            if (selectedCard) {
                selectedCard.classList.add('bg-blue-100', 'dark:bg-blue-800', 'border-blue-300', 'dark:border-blue-600');
                // NO remover la selección - mantener hasta que se cierre modal o seleccione otro
            }

            // NUEVO: Mostrar modal compacto con información del dispositivo
            console.log('🚀 CLICK DEBUG: About to show modal...');
            showCompactModal(device, position);

            // Mostrar indicador de dispositivo siendo tracked
            const indicator = document.getElementById('selectedDeviceIndicator');
            if (indicator) {
                indicator.classList.remove('hidden');
                indicator.textContent = `🎯 Tracking: ${device.name}`;
            }
            
            console.log(`✅ Focused on device: ${device.name} at [${position.latitude}, ${position.longitude}] - WILL PERSIST ON REFRESH`);
        }
        
        // NUEVO: Función para mostrar modal compacto centrado
        function showCompactModal(device, position) {
            console.log('🚀 MODAL DEBUG: Starting showCompactModal for device:', device.name);
            
            try {
                // Asegurar que el mapa siga visible
                forceMapToStayVisible();
                console.log('✅ MODAL DEBUG: Map visibility forced');
                
                // Generar contenido del modal
                console.log('🔧 MODAL DEBUG: Generating modal content...');
                const modalContent = generateCompactModalContent(device, position);
                console.log('✅ MODAL DEBUG: Modal content generated');
                
                // Actualizar contenido
                const contentDiv = document.getElementById('compactModalContent');
                console.log('🔍 MODAL DEBUG: Content div found:', !!contentDiv);
                
                if (contentDiv) {
                    contentDiv.innerHTML = modalContent;
                    console.log('✅ MODAL DEBUG: Content inserted into div');
                } else {
                    console.error('❌ MODAL DEBUG: compactModalContent div NOT FOUND!');
                    return;
                }
                
                // Mostrar modal con animación
                const modal = document.getElementById('compactDeviceModal');
                console.log('🔍 MODAL DEBUG: Modal element found:', !!modal);
                
                if (!modal) {
                    console.error('❌ MODAL DEBUG: compactDeviceModal NOT FOUND!');
                    return;
                }
                
                const modalBox = modal.querySelector('.compact-modal');
                console.log('🔍 MODAL DEBUG: Modal box found:', !!modalBox);
                
                if (modal && modalBox) {
                    console.log('🎬 MODAL DEBUG: Adding show classes...');
                    modal.classList.add('show');
                    modalBox.classList.add('animate-in');
                    
                    console.log('✅ MODAL DEBUG: Modal should now be visible!');
                    console.log('📋 MODAL DEBUG: Modal classes:', modal.className);
                    
                    // Forzar visibilidad del mapa después de mostrar modal
                    setTimeout(forceMapToStayVisible, 100);
                } else {
                    console.error('❌ MODAL DEBUG: Modal or modalBox missing!');
                }
                
            } catch (error) {
                console.error('💥 MODAL DEBUG: Exception in showCompactModal:', error);
            }
        }
        
        // NUEVO: Generar contenido HTML para el modal compacto
        function generateCompactModalContent(device, position) {
            console.log('🎨 CONTENT DEBUG: Starting generateCompactModalContent');
            console.log('🎨 CONTENT DEBUG: Device:', device);
            console.log('🎨 CONTENT DEBUG: Position:', position);
            
            try {
            // Procesar coordenadas PRIMERO
            const coordinates = position && position.latitude && position.longitude 
                ? `${position.latitude.toFixed(4)}, ${position.longitude.toFixed(4)}`
                : 'Sin coordenadas';
                
            // Obtener dirección geocodificada si está disponible
            const address = position && position.address ? position.address : null;
            const hasAddress = address && address !== null;
                
            // DEBUG: Datos del dispositivo (solo para desarrollo)
            if (window.location.hostname === 'localhost' || window.location.hostname.includes('test')) {
                console.log('=== MODAL DEBUG DATA ===');
                console.log('Device:', device.name, 'Speed:', position ? position.speed : 'N/A');
                console.log('Address:', address);
                console.log('Coordinates:', coordinates);
                console.log('Position attributes:', position ? position.attributes : 'N/A');
            }
            
            const isOnline = device.status === 'online';
            const statusColor = isOnline ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400';
            const statusBg = isOnline ? 'bg-green-100 dark:bg-green-900' : 'bg-red-100 dark:bg-red-900';
            const statusDot = isOnline ? 'bg-green-500' : 'bg-red-500';
            
            let lastUpdate = 'N/A';
            if (position && position.deviceTime) {
                const date = new Date(position.deviceTime);
                lastUpdate = date.toLocaleString('es-ES');
            } else if (device && device.lastUpdate) {
                const date = new Date(device.lastUpdate);
                lastUpdate = date.toLocaleString('es-ES');
            }
            
            // Calcular velocidad y estado de movimiento
            let speed = 0;
            let isMoving = false;
            let motionStatus = 'Detenido';
            
            if (position) {
                if (position.speed !== undefined && position.speed !== null) {
                    speed = Math.round(position.speed * 1.852);
                    isMoving = speed > 0 || (position.attributes && position.attributes.motion === true);
                    
                    if (isMoving) {
                        motionStatus = speed > 0 ? 'En movimiento' : 'En marcha (sin velocidad GPS)';
                    } else {
                        motionStatus = 'Detenido';
                    }
                }
            }
            
